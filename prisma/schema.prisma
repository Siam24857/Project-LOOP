generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  feedbacks Feedback[]
  themes    Theme[]
  reports   Report[]
  embeddings Embedding[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(VIEWER)
  workspaceId   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts      Account[]
  sessions      Session[]

  @@index([workspaceId])
  @@index([email])
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Feedback {
  id           String       @id @default(cuid())
  workspaceId  String
  source       FeedbackSource
  customerName String
  customerEmail String
  content      String
  sentiment    Sentiment    @default(NEUTRAL)
  category     String?
  status       FeedbackStatus @default(NEW)
  priority     Priority     @default(MEDIUM)
  language     String       @default("en")
  embedding    Embedding?
  themes       FeedbackTheme[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sentiment])
  @@index([source])
  @@index([status])
  @@index([createdAt])
}

enum FeedbackSource {
  SUPPORT
  APP_REVIEW
  SURVEY
  SALES
  MANUAL
  SIMULATED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Theme {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  feedbackCount Int     @default(0)
  positiveCount Int     @default(0)
  negativeCount Int     @default(0)
  trendScore   Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedbacks    FeedbackTheme[]

  @@index([workspaceId])
  @@unique([workspaceId, name])
}

model FeedbackTheme {
  feedbackId String
  themeId    String

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme    Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  workspaceId String
  feedbackId String   @unique
  vector     String
  createdAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedback  Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Report {
  id         String   @id @default(cuid())
  workspaceId String
  title      String
  summary    String
  content    String
  reportData Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
